{
  "name": "arcana-duel",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --project ./tsconfig.json && vite build",
    "preview": "vite preview",
    "check": "tsx src/engine/selftest.ts",
    "import:ygo": "tsx scripts/import-ygo.ts",
    "verify:original": "node scripts/verify-original.mjs",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "fuzz": "tsx tests/fuzz.ts",
    "coverage": "tsx --test tests/cards/smoke.test.ts && tsx tests/fuzz.ts 300 && tsx scripts/coverage.ts",
    "prepare:ocgcore": "node scripts/prepare-ocgcore.mjs",
    "predev": "npm run prepare:ocgcore",
    "prebuild": "npm run prepare:ocgcore",
    "test:ocgcore": "npm run prepare:ocgcore && node --import tsx --test tests/integration/ocgcore.test.ts",
    "pretest": "npm run prepare:ocgcore"
  },
  "dependencies": {
    "ocgcore-wasm": "0.1.6",
    "phaser": "^3.90.0"
  },
  "devDependencies": {
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": "24.x"
  }
}
