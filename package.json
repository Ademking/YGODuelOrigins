{
  "name": "arcana-duel",
  "private": true,
  "version": "1.4.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build.mjs",
    "preview": "vite preview",
    "check": "tsx src/engine/selftest.ts",
    "import:ygo": "tsx scripts/import-ygo.ts",
    "import:card-text": "tsx scripts/import-card-text.ts",
    "import:card-text:ar": "tsx scripts/import-arabic-card-text.ts",
    "card-text:supplement": "tsx scripts/card-text-supplement.ts",
    "verify:original": "node scripts/verify-original.mjs",
    "test": "tsx --test \"tests/**/*.test.ts\"",
    "fuzz": "tsx tests/fuzz.ts",
    "fuzz:ocgcore": "tsx tests/ocgFuzz.ts",
    "coverage": "tsx --test tests/cards/smoke.test.ts && tsx tests/fuzz.ts 300 && tsx scripts/coverage.ts",
    "prepare:ocgcore": "node scripts/prepare-ocgcore.mjs && tsx scripts/trim-ocgcore.ts",
    "predev": "npm run prepare:ocgcore",
    "test:ocgcore": "npm run prepare:ocgcore && node --import tsx --test tests/integration/ocgcore.test.ts",
    "pretest": "npm run prepare:ocgcore"
  },
  "dependencies": {
    "@sentry/browser": "11.12.0",
    "nostr-tools": "^2.26.0",
    "ocgcore-wasm": "0.1.6",
    "phaser": "^3.90.0",
    "trystero": "0.27.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "tailwindcss": "4.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "engines": {
    "node": "24.x"
  }
}
