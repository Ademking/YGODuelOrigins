// Cloudflare deploy: the built game in dist/ served as static files, plus worker/index.js for the /turn relay logins
// and the /relay lobby relay.
// `previews` lets branch builds make a preview copy with `npx wrangler preview`; previews use their own database,
// so testing never touches real players' stats.
{
  "name": "ygoduelorigins",
  "compatibility_date": "2026-10-01",
  "main": "worker/index.js",
  "triggers": { "crons": ["*/10 * * * *"] },
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "previews": { "d1_databases": [{ "binding": "DB", "database_name": "ygoduelorigins-dev", "database_id": "f5fa504d-fcfe-4125-a82b-b3d76b9b7ef9" }] },
  // the game's own Nostr relay at /relay: one Durable Object holds every connection (worker/relay.js)
  "durable_objects": { "bindings": [{ "name": "RELAY", "class_name": "GameRelay" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["GameRelay"] }],
  // accounts (Discord login) and online stats: worker/accounts.js, tables in worker/schema.sql
  "d1_databases": [{ "binding": "DB", "database_name": "ygoduelorigins", "database_id": "1652de15-76e0-4dde-942f-d6ab51d569a0" }]
}
